{
  "/v1/agents/data": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/agents/data/<agent_name>": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR","AGENT"],
    "POST": ["ADMIN","MANAGER","AGENT"]
  },
  "/v1/agents/images": {
    "POST": ["ADMIN","MANAGER","AGENT"]
  },
  "/v1/agents/images/<queue>": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/agents/provision_logs/<agent_name>": {
    "POST": ["AGENT"]
  },
  "/v1/agents/queues": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"],
    "POST": ["ADMIN","MANAGER","AGENT"]
  },
  "/v1/client-permissions": {
    "GET": ["ADMIN","MANAGER"]
  },
  "/v1/client-permissions/<client_id>": {
    "GET": ["ADMIN","MANAGER"],
    "PUT": ["ADMIN","MANAGER"],
    "DELETE": ["ADMIN"]
  },
  "/v1/events/job/<job_id>": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR","AGENT"]
  },
  "/v1/job": {
    "GET": ["AGENT"],
    "POST": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/job/<job_id>": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/job/<job_id>/action": {
    "POST": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/job/<job_id>/attachments": {
    "GET": ["AGENT"],
    "POST": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/job/<job_id>/events": {
    "POST": ["AGENT"]
  },
  "/v1/job/<job_id>/position": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/job/search": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/oauth2/revoke": {
    "POST": ["ADMIN"]
  },
  "/v1/queues/<queue_name>/agents": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/queues/<queue_name>/jobs": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/queues/wait_times": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/restricted-queues": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"]
  },
  "/v1/restricted-queues/<queue_name>": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"],
    "POST": ["ADMIN","MANAGER"],
    "DELETE": ["ADMIN","MANAGER"]
  },
  "/v1/result/<job_id>": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR","AGENT"],
    "POST": ["AGENT"]
  },
  "/v1/result/<job_id>/artifact": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"],
    "POST": ["AGENT"]
  },
  "/v1/result/<job_id>/log/<log_type>": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR"],
    "POST": ["AGENT"]
  },
  "/v1/result/<job_id>/status": {
    "GET": ["ADMIN","MANAGER","CONTRIBUTOR","AGENT"]
  },
  "/v1/secrets/<client_id>/<path>": {
    "PUT": ["CONTRIBUTOR","MANAGER","ADMIN"],
    "DELETE": ["CONTRIBUTOR","MANAGER","ADMIN"]
  }
}
