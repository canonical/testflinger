    radius: 0
---
flowchart LR
  subgraph server["Testflinger server"]
    direction TB
    api["REST API"]
    subgraph queues["Job queues"]
      queueA2["Queue A2"]
      queueB1["Queue B1"]
      queueA1["Queue A1"]
      queueB2["Queue B2"]
    end
  end

  subgraph host["Agent host"]
    direction TB
    subgraph agentA["Agent A"]
      connectorA["Device connector"]
    end
    subgraph agentB["Agent B"]
      connectorB["Device connector"]
    end
  end

  subgraph clients["Clients"]
    direction TB
    cli["Testflinger CLI"]
    action["submit GitHub action"]
    ui["Web UI"]
  end

  subgraph Devices
    dutA["Device under test"]
    dutB["Device under test"]
  end

  clients -->|submit and track jobs| api
  api -->|hold jobs| queues
  agentA -->|polls its queues| queues
  agentB -->|polls its queues| queues
  connectorA -->|provision and operate| dutA
  connectorB -->|provision and operate| dutB
  host -->|report results| api
