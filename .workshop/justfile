# 
[doc('Describe usage and list the available recipes.')]
help:
    @echo '{{ BOLD }}Testflinger Workshop{{ NORMAL }}'
    @echo
    @echo 'For usage details for a specific recipe, run {{ CYAN }}just --usage RECIPE{{ NORMAL }}'
    @echo
    @just --list --unsorted

[doc('Start the workshop, launch it if required.')]
[group('workshop')]
start:
    #!/usr/bin/env bash
    set -euxo pipefail
    if ! workshop list --no-headers | grep -qE '^dev[[:space:]].*(Stopped|Ready)'; then
        workshop launch dev
    elif workshop list --no-headers | grep -qE '^dev[[:space:]].*Stopped'; then
        workshop start dev
    elif workshop list --no-headers | grep -qE '^dev[[:space:]].*Ready'; then
        echo "Workshop already started."
    else
        echo "Unhandled case: workshop list:"
        workshop list
    fi

[doc('Clean up docker files in the workshop.')]
[group('workshop')]
docker-prune:
    workshop exec dev -- docker system prune -a -f

[doc('Start the server in the workshop and connect it to the host.')]
[group('server')]
serve: start && connect
    workshop exec dev -- just server::serve

[doc('Disconnect the server from the host and tear it down within the workshop.')]
[group('server')]
teardown: disconnect
    workshop exec dev -- just server::teardown

[doc('Disconnect the server in the workshop from the host.')]
[group('server')]
disconnect:
    -workshop disconnect dev/system:localhost-tcp5000
    -workshop disconnect dev/system:localhost-tcp9090
    -workshop disconnect dev/system:localhost-tcp5556
    -workshop disconnect dev/system:expose-tcp5000
    -workshop disconnect dev/system:expose-tcp9090
    -workshop disconnect dev/system:expose-tcp5556

[doc('Connect the server in the workshop to localhost only.')]
[group('server')]
connect: disconnect
    workshop connect dev/system:localhost-tcp5000 dev/docker-ce:testflinger-server
    workshop connect dev/system:localhost-tcp9090 dev/docker-ce:testflinger-metrics
    workshop connect dev/system:localhost-tcp5556 dev/docker-ce:dex-server

[doc('Expose the server from the workshop on all host network interfaces for trusted-network demos.')]
[group('server')]
connect-expose: disconnect
    workshop connect dev/system:expose-tcp5000 dev/docker-ce:testflinger-server
    workshop connect dev/system:expose-tcp9090 dev/docker-ce:testflinger-metrics
    workshop connect dev/system:expose-tcp5556 dev/docker-ce:dex-server

[doc('Start the pre-commissioned sibling Workshop used as a no-provision DUT.')]
[group('dut')]
start-dut:
    #!/usr/bin/env bash
    set -euxo pipefail
    keydir="agent/devel/.testflinger/noprovision"
    mkdir -p "$keydir"
    if [ ! -f "$keydir/id_ed25519" ]; then
        ssh-keygen -q -t ed25519 -N '' -f "$keydir/id_ed25519"
    fi
    if ! workshop list --no-headers | grep -qE '^dut[[:space:]].*(Stopped|Ready)'; then
        workshop launch dut
    elif workshop list --no-headers | grep -qE '^dut[[:space:]].*Stopped'; then
        workshop start dut
    elif workshop list --no-headers | grep -qE '^dut[[:space:]].*Ready'; then
        echo "DUT workshop already started."
    else
        echo "Unhandled case: workshop list:"
        workshop list
        exit 1
    fi
    workshop refresh dut

[doc('Verify that dev can reach the sibling DUT over SSH.')]
[group('dut')]
check-dut: start start-dut
    #!/usr/bin/env bash
    set -euxo pipefail
    dut_instance="$(lxc list --project "workshop.${USER}" --format csv -c n | grep -m1 '^dut-')"
    test -n "$dut_instance"
    dut_hostname="${dut_instance}.workshop"
    sed "s/DUT_HOSTNAME/$dut_hostname/" agent/devel/noprovision-dut.yaml > agent/devel/.testflinger/noprovision/noprovision-dut.yaml
    workshop exec dev -- getent hosts "$dut_hostname"
    workshop exec dev -- bash -lc '
        install -D -m 600 agent/devel/.testflinger/noprovision/id_ed25519 ~/.ssh/id_ed25519
        ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null workshop@'"$dut_hostname"' /bin/true
    '

[doc('Stop the sibling DUT Workshop.')]
[group('dut')]
stop-dut:
    workshop stop dut

[doc('Test the workshop operations.')]
[confirm("Note that you may need to `just workshop disconnect` elsewhere. To continue enter 'y'.")]
[group('test')]
test:
    python3 test_workshop_actions.py
