[doc('Describe usage and list the available recipes.')]
help:
    @echo '{{ BOLD }}Testflinger Agent Host Charm{{ NORMAL }}'
    @echo
    @echo 'For usage details for a specific recipe, run {{ CYAN }}just --usage RECIPE{{ NORMAL }}'
    @echo
    @just --list --unsorted

[confirm('Install Juju and prepare environment (destructive)?')]
[doc('Set up integration test environment (destructive).')]
[group('project')]
setup:
    sudo snap install --classic concierge
    sudo concierge prepare --verbose

[doc('Fetch charm libraries.')]
[group('project')]
fetch-libs:
    @charmcraft fetch-libs

[doc('Add a dependency (uv add ...).')]
[group('venv')]
[positional-arguments]
add +args:
    @uv add "$@"

[doc('Remove a dependency (uv remove ...).')]
[group('venv')]
[positional-arguments]
remove +args:
    @uv remove "$@"

[doc("Generate lockfile.")]
[group('venv')]
lock:
    @uv lock

[doc("Check lockfile.")]
[group('venv')]
check-lock:
    @uvx tox run -e lock

[doc("Update the project's environment.")]
[group('venv')]
venv:
    @uv sync --all-groups
    @echo 'Activate the Python environment: {{ CYAN }}source .venv/bin/activate{{ NORMAL }}'

[doc('Format all files.')]
[group('lint')]
format:
    @uvx tox run -e format

[doc('Lint all files.')]
[group('lint')]
lint:
    @uvx tox run -e lint

[doc('Run unit tests.')]
[group('test')]
test:
    @uvx tox run -e unit

[doc('Run all checks.')]
[group('test')]
check: lint format test
    @echo 'Agent charm checks done!'

[doc('Remove tox environments (forces full reinstall on next run).')]
[group('venv')]
clean:
    @rm -rf .tox

[doc('Run integration tests. Builds only for the host platform.')]
[group('test')]
[positional-arguments]
integration *args: pack-host
    @uvx tox run -e integration -- "$@"

[doc('Build the charm package (all bases for host architecture)')]
[group('package')]
pack:
    @charmcraft pack

[doc('Build the charm package for the host platform only (destructive in CI, LXD locally)')]
[group('package')]
pack-host:
    #!/usr/bin/env bash
    PLATFORM="ubuntu@$(. /etc/os-release && echo $VERSION_ID):$(dpkg --print-architecture)"
    if [ "{{ env('CI', 'false') }}" = "true" ]; then
        # Destructive mode needs root to install build-packages
        /usr/bin/sudo charmcraft pack --platform "$PLATFORM" --destructive-mode
    else
        charmcraft pack --platform "$PLATFORM"
    fi
