# Agent Host charm sub-recipes.
mod charm 'charms/testflinger-agent-host-charm'

[doc('Describe usage and list the available recipes.')]
help:
    @echo '{{ BOLD }}Testflinger Agent{{ NORMAL }}'
    @echo
    @echo 'For usage details for a specific recipe, run {{ CYAN }}just --usage RECIPE{{ NORMAL }}'
    @echo
    @just --list --unsorted

[doc('Add a dependency (uv add ...).')]
[group('venv')]
[positional-arguments]
add +args:
    @uv add "$@"

[doc('Remove a dependency (uv remove ...).')]
[group('venv')]
[positional-arguments]
remove +args:
    @uv remove "$@"

[doc("Generate lockfile.")]
[group('venv')]
lock:
    @uv lock

[doc("Check lockfile.")]
[group('venv')]
check-lock:
    @uvx tox run -e lock

[doc("Update the project's environment.")]
[group('venv')]
venv:
    @uv sync
    @echo 'Activate the Python environment: {{ CYAN }}source .venv/bin/activate{{ NORMAL }}'

[doc('Format all files.')]
[group('lint')]
format:
    @uvx tox run -e format

[doc('Lint all files.')]
[group('lint')]
lint:
    @uvx tox run -e lint

[doc('Run unit tests.')]
[group('test')]
test:
    @uvx tox run -e unit

[doc('Run all checks.')]
[group('test')]
check: lint format test
    @echo 'Agent checks done!'

[doc('Remove tox environments (forces full reinstall on next run).')]
[group('venv')]
clean:
    @rm -rf .tox

[doc('Start a device connector agent (fake_connector runs on the host; other connectors run in `dev`).')]
[group('deploy')]
start connector='fake_connector' agent_name='' server_url='http://localhost:5000':
    #!/usr/bin/env bash
    set -euxo pipefail
    runtime_dir="devel/.testflinger"
    
    # Use provided agent_name, or derive it from connector if not provided
    name="{{ agent_name }}"
    if [ -z "$name" ]; then
        name="{{connector}}"
    fi
    
    config="$runtime_dir/${name}-agent.conf"
    token="$runtime_dir/refresh-token"
    install -D -m 600 "devel/{{connector}}-agent.conf" "$config"
    
    # Update agent configuration with the provided name and connector
    python3 devel/update_config.py "{{connector}}" "$name" "{{server_url}}" "$config"
    
    uv run python devel/refresh-token-getter.py "{{server_url}}" "$token"
    uv run --group test testflinger-agent -c "$config" --token-file "$token"
